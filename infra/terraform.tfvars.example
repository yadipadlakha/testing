# Copy this file to terraform.tfvars and fill in your real values.
# terraform.tfvars is gitignored — never commit real secrets.

aws_region  = "us-east-1"
app_name    = "travel-everywhere"
environment = "production"

domain_name     = "traveleverywhere.com"
route53_zone_id = "Z0123456789ABCDEFGHIJ" # aws route53 list-hosted-zones-by-name --dns-name traveleverywhere.com

github_repository_url = "https://github.com/yadipadlakha/testing"
github_owner_repo     = "yadipadlakha/testing"
deploy_branch         = "main"

db_name     = "travel_everywhere"
db_username = "travel_admin"

# Sensitive values below — prefer passing these as environment variables
# instead of writing them into this file, even though it's gitignored:
#   export TF_VAR_github_access_token="ghp_..."
#   export TF_VAR_db_password="$(openssl rand -base64 24)"
#   export TF_VAR_auth_secret="$(npx auth secret --raw 2>/dev/null || openssl rand -base64 33)"
#
# github_access_token = "ghp_..."
# db_password         = "..."
# auth_secret         = "..."
