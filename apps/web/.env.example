# Postgres connection string. With the bundled docker-compose.yml:
# docker compose up -d
DATABASE_URL="postgresql://travel:travel@localhost:5432/travel_crm"

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-with-a-random-secret"

# Anthropic API key for AI itinerary generation
# https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."
