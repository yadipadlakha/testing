# Copy this file to terraform.tfvars and fill in your real values.
# terraform.tfvars is gitignored — never commit real secrets.
#
# This Terraform only provisions the RDS Postgres database. The Amplify app
# (Bitbucket connection, build, domain) is set up separately via the AWS
# Console — see DEPLOYMENT.md.

aws_region  = "us-east-1"
app_name    = "travel-everywhere"
environment = "production"

db_name     = "travel_everywhere"
db_username = "travel_admin"

# Sensitive value below — prefer passing it as an environment variable
# instead of writing it into this file, even though it's gitignored:
#   export TF_VAR_db_password="$(openssl rand -base64 24)"
#
# db_password = "..."
