generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum Module {
  ENQUIRY
  HOTEL
  SIGHTSEEING
  TRANSPORT
}

enum EnquiryStatus {
  NEW_QUERY
  QUOTATION_SENT
  ON_HOLD
  CONVERTED
  FOLLOW_UP
  LOST
}

enum EnquiryType {
  HOLIDAY_PACKAGE
  FLIGHT_ONLY
  HOTEL_ONLY
  VISA
  OTHER
}

enum QuotationItemCategory {
  HOTEL
  SIGHTSEEING
  TRANSPORT
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdById String?
  createdBy   User?  @relation("EmployeeCreator", fields: [createdById], references: [id])
  employees   User[] @relation("EmployeeCreator")

  resetTokens PasswordResetToken[]
  permissions EmployeePermission[]

  allocatedEnquiries Enquiry[] @relation("AllocatedEnquiries")
  createdEnquiries   Enquiry[] @relation("CreatedEnquiries")

  createdHotels      Hotel[]       @relation("CreatedHotels")
  createdSightseeing Sightseeing[] @relation("CreatedSightseeing")
  createdTransport   Transport[]   @relation("CreatedTransport")
  createdQuotations  Quotation[]   @relation("CreatedQuotations")

  @@index([createdById])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmployeePermission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module

  @@unique([userId, module])
}

model Client {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  email       String?
  companyName String?
  city        String?
  state       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enquiries Enquiry[]
}

model Enquiry {
  id            String        @id @default(cuid())
  enquiryNumber Int           @unique @default(autoincrement())
  status        EnquiryStatus @default(NEW_QUERY)
  type          EnquiryType   @default(HOLIDAY_PACKAGE)

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  travelTo     String
  travelDate   DateTime
  durationDays Int
  adults       Int     @default(1)
  children     Int     @default(0)
  childrenAges String?

  hotelCategory Int?
  currency      String @default("INR")

  notes String?

  allocatedToId String?
  allocatedTo   User?   @relation("AllocatedEnquiries", fields: [allocatedToId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedEnquiries", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations Quotation[]

  @@index([status])
  @@index([allocatedToId])
  @@index([clientId])
}

model Hotel {
  id            String  @id @default(cuid())
  name          String
  destination   String
  starRating    Int?
  address       String?
  contactPerson String?
  contactPhone  String?
  contactEmail  String?
  pricePerNight Int?
  notes         String?

  createdById String
  createdBy   User   @relation("CreatedHotels", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([destination])
}

model Sightseeing {
  id           String  @id @default(cuid())
  name         String
  country      String
  city         String
  starRating   Float?
  duration     String?
  address      String?
  latitude     Float?
  longitude    Float?
  contactPhone String?
  tourSummary  String?
  price        Int?

  activityTypes SightseeingActivityType[]
  rates         SightseeingRate[]

  createdById String
  createdBy   User   @relation("CreatedSightseeing", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country, city])
}

model SightseeingActivityType {
  id           String        @id @default(cuid())
  name         String        @unique
  sightseeings Sightseeing[]
  createdAt    DateTime      @default(now())
}

model SightseeingRate {
  id            String      @id @default(cuid())
  sightseeingId String
  sightseeing   Sightseeing @relation(fields: [sightseeingId], references: [id], onDelete: Cascade)

  title      String?
  startDate  DateTime
  endDate    DateTime
  daysOfWeek String[]

  adultRate  Int?
  minAdult   Int?
  maxAdult   Int?
  childRate  Int?
  minChild   Int?
  maxChild   Int?
  infantRate Int?
  minInfant  Int?
  maxInfant  Int?

  cancelPolicy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sightseeingId])
  @@index([startDate, endDate])
}

model Transport {
  id            String  @id @default(cuid())
  vehicleType   String
  destination   String
  capacity      Int?
  pricePerDay   Int?
  contactPerson String?
  contactPhone  String?
  notes         String?

  createdById String
  createdBy   User   @relation("CreatedTransport", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([destination])
}

model Quotation {
  id              String   @id @default(cuid())
  quotationNumber Int      @unique @default(autoincrement())

  enquiryId String
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  title              String
  currency           String
  validUntil         DateTime?
  discount           Int     @default(0)
  taxPercent         Int     @default(0)
  termsAndConditions String?

  items QuotationItem[]

  createdById String
  createdBy   User   @relation("CreatedQuotations", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enquiryId])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  category    QuotationItemCategory @default(OTHER)
  description String
  quantity    Int                   @default(1)
  unitPrice   Int
  sortOrder   Int                   @default(0)

  @@index([quotationId])
}
