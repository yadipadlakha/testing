# Postgres connection string. With the bundled docker-compose.yml:
# docker compose up -d
DATABASE_URL="postgresql://travel:travel@localhost:5432/travel_everywhere"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-with-a-random-secret"

# SMTP — used to email quotations to clients from the quotation view page.
# Works with Gmail app passwords, SendGrid, AWS SES SMTP credentials, etc.
# Leave unset in dev — "Send" will show a clear error instead of failing silently.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="apikey-or-username"
# SMTP_PASSWORD="replace-with-your-smtp-password"
# SMTP_FROM="TravelEverywhere <quotations@traveleverywhere.com>"
