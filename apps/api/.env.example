# PostgreSQL connection string.
DATABASE_URL="postgresql+psycopg://travel:travel@localhost:5432/travel_dmc"

# JWT signing key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="replace-with-a-random-secret"

# JSON array of allowed frontend origins; defaults to ["http://localhost:3000"] if unset.
# CORS_ALLOW_ORIGINS='["http://localhost:3000"]'

# Optional: required only for the future `ai` module.
ANTHROPIC_API_KEY=""

ENVIRONMENT="development"
