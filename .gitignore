# Monorepo-wide ignores. See https://help.github.com/articles/ignoring-files/

# --- Node / Next.js (apps/web) ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel

# --- Python / FastAPI (apps/api) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# --- Env files (opt in explicitly where needed) ---
.env
.env.*
!.env.example
!*/.env.example

# --- Misc ---
.DS_Store
*.pem
coverage/
